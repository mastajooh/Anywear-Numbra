<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Game-independent logic for Anywear Numbra: settings, equipment scope filter,
    outfit selection, territory rule matching and the transition state machine.
    It deliberately has NO package dependencies (it uses System.Text.Json from the BCL),
    so the plugin never ships a second copy of a library Dalamud already provides,
    and the unit tests can run on any OS without Dalamud or the game.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AnywearNumbra</RootNamespace>
    <AssemblyName>AnywearNumbra.Core</AssemblyName>
    <Version>0.1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
