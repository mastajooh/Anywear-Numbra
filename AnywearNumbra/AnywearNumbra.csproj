<?xml version="1.0" encoding="utf-8"?>
<!-- Dalamud.NET.Sdk 15.0.0 (Dalamud API 15, net10.0-windows, x64) - verified against goatcorp/Dalamud.NET.Sdk and goatcorp/SamplePlugin. -->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.0.0</Version>
    <RootNamespace>AnywearNumbra</RootNamespace>
    <AssemblyName>AnywearNumbra</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Manifest fields consumed by DalamudPackager. -->
    <Author>Anywear Numbra contributors</Author>
    <Name>Anywear Numbra</Name>
    <Punchline>Changes your outfit (equipment only) from Glamourer designs or Penumbra mods when you change zones or enter duties.</Punchline>
    <Description>Anywear Numbra applies the equipment portion of your saved Glamourer designs to your own character after zone changes, teleports and duty entry. Hair, face, skin, body, identity and visual effects are never sent to Glamourer. Weapons, facewear and hat/visor visibility are opt-in. Can also pick a random enabled Penumbra mod and wear the armor it changes. Requires Glamourer; Penumbra is needed for mod outfits.</Description>
    <RepoUrl>https://github.com/mastajooh/Anywear-Numbra</RepoUrl>
    <Tags>glamourer;penumbra;outfit;glamour;appearance;automation</Tags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnywearNumbra.Core\AnywearNumbra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\images\icon.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
